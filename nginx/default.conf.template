# Єдина точка входу. Алгоритм балансування задається змінною LB_ALGO
# (round-robin | least-conn | weighted | ip-hash) — підключається відповідний upstream-файл.
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;

include /etc/nginx/shop/upstream-${LB_ALGO}.conf;

log_format lb '$remote_addr "$request" $status rt=$request_time '
              'upstream=$upstream_addr ust=$upstream_status urt=$upstream_response_time';

server {
    listen 80;
    access_log /var/log/nginx/access.log lb buffer=64k flush=1s;

    location / {
        proxy_pass http://shop_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_connect_timeout 1s;
        proxy_read_timeout 15s;
        # Passive health check: при помилці з'єднання / 502-504 запит іде на наступний вузол.
        # POST після відправки на upstream не повторюється (non_idempotent вимкнено) — захист від дублів замовлень.
        # 503 сюди НЕ входить: це контрольована відмова перевантаженого, але живого вузла (load shedding).
        # Якщо рахувати 503 як failure, під піковим навантаженням nginx виводить з пулу ВСІ вузли → каскадна відмова.
        proxy_next_upstream error timeout http_502 http_504;
        proxy_next_upstream_tries 3;
        proxy_next_upstream_timeout 5s;
    }

    location = /lb-status {
        stub_status;
        access_log off;
    }
}
